{
  // Auto-save "afterDelay" skips format + ESLint fix on save. "onFocusChange" runs
  // them when you switch tab or window (Ctrl+S runs them too).
  "files.autoSave": "onFocusChange",

  // Prettier formats on save (spaces, quotes, line breaks). It never sorts imports.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // ESLint fixes on save: removes unused imports, sorts imports, adds `import type`, ...
  // organizeImports is OFF: it sorts imports its own way and fights ESLint.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "never",
    "source.sortImports": "never"
  },

  // Same again per language, so user-level language settings can't win.
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always",
      "source.organizeImports": "never",
      "source.sortImports": "never"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always",
      "source.organizeImports": "never",
      "source.sortImports": "never"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always",
      "source.organizeImports": "never",
      "source.sortImports": "never"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // Two trailing spaces are a line break in Markdown.
    "files.trimTrailingWhitespace": false
  },

  // Auto-detects an eslint.config.js in a monorepo package, if you add one later.
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],

  // Use the TypeScript version from this repo (TypeScript 7), not the editor's built-in one.
  "js/ts.tsdk.path": "node_modules/@typescript/native",
  "js/ts.experimental.useTsgo": true,
  // Older VS Code / Cursor builds read these names instead.
  "typescript.tsdk": "node_modules/@typescript/native/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  // Auto-imports: relative paths inside one package, package names ("@packages/shared")
  // across packages, and keep the .js extension (NodeNext).
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  // Never suggest a relative path into another package ("../../../shared/src/...").
  "typescript.preferences.autoImportSpecifierExcludeRegexes": ["^(\\./)?(\\.\\./){2,}[^/]+/src/"],

  // Same file format on every OS.
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,

  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [100],

  // Hide generated folders from the sidebar and from search.
  "files.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/.next": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/.next": true,
    "pnpm-lock.yaml": true
  }
}
